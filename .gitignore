# Bağımlılıklar (npm install ile geri gelir; package-lock.json commit'lenir)
node_modules/

# Loglar
logs/
*.log
npm-debug.log*

# Node tanı raporları (node --report)
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Test kapsamı (node --test --experimental-test-coverage, c8, nyc)
coverage/
.nyc_output/
*.lcov

# Ortam değişkenleri (ör. PORT); örnek dosya paylaşılabilir
.env
.env.*
!.env.example

# npm pack çıktısı
*.tgz

# Editör / IDE (paylaşılabilir VS Code ayarları hariç)
.vscode/*
!.vscode/extensions.json
!.vscode/launch.json
.idea/
*.swp

# Claude Code kişisel ayarları
.claude/settings.local.json

# İşletim sistemi ve OneDrive artıkları
.DS_Store
Thumbs.db
desktop.ini
*.tmp
